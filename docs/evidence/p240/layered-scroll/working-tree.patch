+internal fun TitleLayer(d: TmdbDetail.Details, fg: Color) {
+    Box(
+        Modifier.fillMaxWidth().height(DETAIL_TITLE_BAND_DP.dp).padding(horizontal = 24.dp),
+        contentAlignment = Alignment.BottomCenter,
