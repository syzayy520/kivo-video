#!/bin/bash
# 只做一件事：导出交叉编译 libmpv 所需的**全部**环境变量。
#
# 用法（不要直接执行，要 source）：
#   source android/app/buildscripts/mpv/toolchain.env
#
# 【为什么单独一个文件】build-libmpv.sh 与其它脚本都要用同一套路径；
# 路径散落在多处 ⇒ 换机器时漏改一处就会编出**静默错误**的产物（编得过但链错库）。
# 这里做唯一真相源。
#
# 【⚠️ NDK 版本必须与 mpv 首次构建时一致】
# 本机实际的 mpv build 目录（meson-info/intro-compilers.json）记录的是
# **clang 21.0.0** = NDK **30.0.16248370**。
# 2026-11-15 曾在不知情的情况下用 NDK 27（clang 18.0.1）做过增量重编
# ⇒ 同一个 .so 混了两代编译器。已记录为缺陷，本文件把它钉死。
# 要换 NDK 必须**删除 build 目录完整重编**，不允许只改这里。

# ---- 工具链 ----
# Git Bash 形式（给 shell 用）
export KIVO_NDK="/c/Android/sdk/ndk/30.0.16248370"
# Windows 形式（给 meson cross file / clang 用；两者不能混）
export KIVO_NDK_WIN="C:/Android/sdk/ndk/30.0.16248370"

# 目标 API：与 App 的 minSdk 一致（build.gradle.kts）。
# mpv 的 Android VO 需要 API 26+ 的 ANativeWindow 符号。
export KIVO_API=26

# clang 的三元组前缀
export KIVO_TRIPLE="aarch64-linux-android${KIVO_API}"

# ---- 依赖（全部是预编译产物，不入库）----
export KIVO_MPV_SRC="/c/re-tools/mpv-build/mpv"                 # mpv v0.39.0 源码
export KIVO_FFMPEG="/c/re-tools/ffmpeg-shared-dist"             # libav* 61.19 / 59.39
export KIVO_LIBASS="/c/re-tools/libass-android/dist"            # libass 0.16.0
export KIVO_LIBPLACEBO="/c/re-tools/libplacebo-android"         # libplacebo 7.391.0

# 构建目录（与源码同级，名字固定 ⇒ 脚本可重复执行）
export KIVO_BUILD="$KIVO_MPV_SRC/build"

# ---- pkg-config ----
# 【为什么必须是 msys 的 pkg-config】三个依赖的 .pc 里是 POSIX 风格路径
# （`prefix=/c/re-tools/...`）。msys 版 pkg-config 会自动把它转成
# `C:/re-tools/...`；换原生 Windows 版 pkg-config 会原样输出 `/c/...`
# ⇒ clang 找不到头文件。这就是家族树里 pkg-config-shim.py 想解决的问题，
# 实测 **msys 版已经够用，不需要自写 shim**（见 281 说明）。
export KIVO_PKG_CONFIG="/c/msys64/usr/bin/pkg-config.exe"

# 依赖查找路径
export PKG_CONFIG_PATH="$KIVO_FFMPEG/lib/pkgconfig:$KIVO_LIBASS/lib/pkgconfig:$KIVO_LIBPLACEBO/lib/pkgconfig"
# sysroot：让 pkg-config 把 -I/-L 定位到 NDK 的 sysroot 下
export PKG_CONFIG_SYSROOT_DIR="$KIVO_NDK_WIN/toolchains/llvm/prebuilt/windows-x86_64/sysroot"

# ---- PATH ----
# 只把 NDK 的 bin 放进 PATH（保证 clang / llvm-ar / llvm-strip 解析到 NDK 30 那一套）。
#
# 【⚠️ 不要把 /c/msys64/usr/bin 加进 PATH】踩过：
# msys 的 `meson` 脚本 shebang 是 `#!/usr/bin/python`，在 Git Bash 里解析不到
# ⇒ 报 `bad interpreter: No such file or directory`，整个构建起不来。
# msys 的 pkg-config **只在 cross file 里用绝对路径调用**，不需要进 PATH。
export PATH="$KIVO_NDK/toolchains/llvm/prebuilt/windows-x86_64/bin:$PATH"

# ---- 自检 ----
# 被 source 时立刻验证「NDK 版本真的是 30」——
# 这是本文件存在的核心理由（防止又一次静默用错编译器）。
kivo_toolchain_selfcheck() {
  local clang="$KIVO_NDK/toolchains/llvm/prebuilt/windows-x86_64/bin/clang.exe"
  if [ ! -x "$clang" ]; then
    echo "❌ 找不到 clang：$clang" >&2
    return 1
  fi
  local ver
  ver="$("$clang" --version 2>/dev/null | head -1)"
  case "$ver" in
    *"clang version 21."*) : ;;
    *)
      echo "⚠️ clang 版本不是 21.x（mpv 首次构建用的是 clang 21.0.0 / NDK 30）" >&2
      echo "   实际：$ver" >&2
      echo "   ⇒ 要么改回 NDK 30，要么删掉 build 目录完整重编。不要增量混编。" >&2
      return 1
      ;;
  esac
  if [ ! -x "$KIVO_PKG_CONFIG" ]; then
    echo "❌ 找不到 msys pkg-config：$KIVO_PKG_CONFIG" >&2
    return 1
  fi
  return 0
}
kivo_toolchain_selfcheck || {
  echo "toolchain.env 自检失败（见上）—— 继续构建会产出不可信的二进制。" >&2
  return 1 2>/dev/null || exit 1
}
