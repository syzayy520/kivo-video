<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 250 S3/S6：NetworkLinkMonitor 查 activeNetwork 需要它。缺了会抛 SecurityException，
         断网看门狗静默失效、用户又要等满读超时才知道断了。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:allowBackup="false"
        android:label="Kivo Cinema"
        android:supportsRtl="true"
        android:theme="@style/Theme.KivoCinema" android:usesCleartextTraffic="true">

                <activity android:name=".MainActivity"
                    android:exported="true">
                    <intent-filter>
                        <action android:name="android.intent.action.MAIN"/>
                        <category android:name="android.intent.category.LAUNCHER"/>
                    </intent-filter>
                </activity>
                <activity android:name=".library.MediaLibraryActivity" android:exported="true"/>
                <activity android:name=".smb.ui.SmbBrowserActivity" android:exported="false"/>
                <activity android:name=".emby.EmbyActivity" android:exported="true"/>
                <activity android:name=".emby.aggregate.ui.AggregateActivity" android:exported="false"/>
                <activity android:name=".privatezone.PrivateActivity" android:exported="true"/>
                <activity android:name=".ui.detail.DetailActivity" android:exported="true"/>
                <activity android:name=".ui.detail.MovieDetailActivity"/>
<activity
            android:name=".ui.compose.PlayerComposeActivity"
            android:screenOrientation="landscape"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:exported="true" />
        <activity
            android:name=".ui.PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- P13-A 帧率能力探针：无 UI，采集完即 finish。
             单独一条 Activity 的理由：它不需要 Surface、不需要片源，
             塞进 PlayerActivity 会让"打开播放器"与"采一次能力"耦合。 -->
        <activity
            android:name=".ui.FramerateDumpActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true" />

        <!-- P12-D2 多路并发解码探针。与 PlayerActivity 分开：那个是"一条会话 + 一个面"，
             这条要的是 N 条同时跑，塞进去会把 onSurfaceAvailable 的一对一假设打破。 -->
        <activity
            android:name=".ui.MultiPlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:screenOrientation="landscape" />

            <service
            android:name=".playback.PlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />
        <service android:name=".download.DownloadService"
                android:foregroundServiceType="dataSync" />
    </application>

</manifest>
