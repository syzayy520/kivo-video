<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 播放器壳：无标题、黑底。edge-to-edge 由 MainActivity enableEdgeToEdge() 接管
        （239：hero 需顶入状态栏下——windowFullscreen 与之互斥，删除）。 -->
    <style name="Theme.KivoCinema" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorBackground">@android:color/black</item>
        <!-- 312 · 窗口底色 = 品牌启动动画底色，避免冷启动白闪。
             【已回退主题拆分】曾拆成 Base + 派生以便 v31 加系统启动页属性，
             但那是今晚唯一触及播放页的改动，回退它验证"进度条多一条"是否因此而来。 -->
        <item name="android:windowBackground">@color/brand_startup_background</item>
        <!-- 335 · 页面切换淡入淡出，消除进出页面的黑/白空窗。只改窗口过渡，
             不动 windowBackground/页面内部 UI（避免重蹈改主题导致进度条异常的覆辙）。 -->
        <item name="android:windowAnimationStyle">@style/KivoWindowAnimation</item>
    </style>

    <style name="KivoWindowAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/kivo_fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/kivo_fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/kivo_fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/kivo_fade_out</item>
    </style>
</resources>
